  'eobroker.com',
  'eo.broker',
  'eobroker.dev',
  'eo-trading.com',
  'eoinvesting.com',
];

const BASE_DOMAIN = (() => {
  const index = AVAILABLE_DOMAINS.findIndex(p => globalThis.location.host.match(p));
  if (index >= 0) {
    return AVAILABLE_DOMAINS[index];
  }
  return AVAILABLE_DOMAINS[0];
})();

const PATH = location.pathname.replace(/\/+$/, '');

function safeRedirect(url) {
  const urlObj = new URL(url);
  if (urlObj.hostname !== location.hostname || urlObj.pathname !== location.pathname) {
    location.replace(url);
    return true;
  }
  return false;
}

/**
 * @param appType {string} - app, m
 * @returns {string}
 */
function getRedirectUrl(appType) {
  return `https://${appType}.${BASE_DOMAIN}${location.pathname}${location.search}${location.hash}`;
}

function redirectPwa() {
  if (IS_MOBILE && location.href.match('://app.')) {
    const url = getRedirectUrl('m');
    return safeRedirect(url);
  }

  if (!IS_MOBILE && location.href.match('://m.')) {
    const url = getRedirectUrl('app');
    return safeRedirect(url);
  }
}

redirectPwa();
